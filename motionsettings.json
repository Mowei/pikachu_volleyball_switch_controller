{ // 修改後需重新啟動程式才會套用新的體感參數
  // 加速度單位為重力加速度 g（原始感測值 / 2048），陀螺儀單位為度/秒（原始感測值 / 16，實務上限約 ±2048）
  // 判定左右移動的加速度門檻（超過此值才開始按住方向鍵）。建議範圍 0.3 ~ 1.5，數值越小越靈敏、越容易誤觸
  "MoveThreshold": 0.6,
  // 已按住方向鍵時的鬆開門檻，需低於此值才放開（避免抖動連點）。須小於 MoveThreshold，建議為其 40% ~ 80%
  "MoveReleaseThreshold": 0.36,
  // 判定跳躍的加速度門檻（向上加速度超過此值觸發一次跳躍）。建議範圍 1.2 ~ 3.0，數值越大需甩動越用力才會觸發
  "JumpThreshold": 1.7,
  // 判定下蹲的加速度門檻（向下加速度低於此值開始按住下蹲鍵）。建議範圍 -0.5 ~ -2.0（負值，絕對值越大越不靈敏）
  "DownThreshold": -1.0,
  // 已按住下蹲鍵時的鬆開門檻，需高於此值（更接近 0）才放開。須介於 DownThreshold 與 0 之間，建議為其 40% ~ 80%
  "DownReleaseThreshold": -0.6,
  // 判定揮擊動作的陀螺儀角速度門檻（任一軸超過此值觸發一次攻擊）。建議範圍 800 ~ 2500，過高可能因感測器上限而永遠無法觸發
  "HitThreshold": 1800.0,
  // 跳躍/攻擊觸發後的冷卻時間（毫秒），避免同一動作連續誤觸。建議範圍 100 ~ 500
  "MotionCooldownMs": 250,
  // 是否偵測手把水平靜止並自動觸發一次體感校正（無需手動點選「開始校正」）
  "AutoCalibrationEnabled": true,
  // 判定靜止的加速度向量長度與 1g 之容忍誤差。建議範圍 0.02 ~ 0.1，數值越小要求越平穩
  "StillAccelTolerance": 0.05,
  // 判定靜止的陀螺儀角速度容忍值（度/秒），任一軸超過此值視為仍在移動。建議範圍 2 ~ 10
  "StillGyroTolerance": 5.0,
  // 需持續靜止多久（毫秒）才自動觸發校正，避免短暫停頓誤觸。建議範圍 500 ~ 2000
  "StillDurationMs": 1000
}