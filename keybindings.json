{
  // 按鍵名稱需對應 KeyboardSender.cs 裡 VirtualKeyShort 列舉的成員名稱（例如 KEY_A、SPACE、F1、OEM_1 等）
  // 修改後需重新啟動程式才會套用新的按鍵綁定
  "SinglePlayer": {
    // 單人模式：命令列參數帶入 single 時使用（例如 dotnet run -- single）
    // 手把向上加速度超過 JumpThreshold 時觸發
    "Jump": "UP_ARROW",
    // 手把向下加速度低於 DownThreshold 時按住
    "Down": "DOWN_ARROW",
    // 手把向左傾斜超過 MoveThreshold 時按住
    "Left": "LEFT_ARROW",
    // 手把向右傾斜超過 MoveThreshold 時按住
    "Right": "RIGHT_ARROW",
    // 任一軸向陀螺儀角速度超過 HitThreshold 時觸發（揮擊動作）
    "Hit": "RETURN",
    // 實體按鈕對鍵盤鍵位（非體感，需開啟系統匣「按鈕轉按鍵」選項），可用鍵名：A、B、X、Y、L、R、ZL、ZR、Plus、Minus、Home、Capture、LStick、RStick、SL、SR、DPadUp、DPadDown、DPadLeft、DPadRight
    "Buttons": {
      "A": "KEY_Z",
      "B": "KEY_X",
      "X": "KEY_C",
      "Y": "KEY_V",
      "L": "KEY_Q",
      "R": "KEY_W",
      "DPadUp": "UP_ARROW",
      "DPadDown": "DOWN_ARROW",
      "DPadLeft": "LEFT_ARROW",
      "DPadRight": "RIGHT_ARROW",
      "Plus": "RETURN",
      "Minus": "ESCAPE"
    }
  },
  "LeftPlayer": {
    // 1P（左控制器）
    "Jump": "KEY_R",
    "Down": "KEY_F",
    "Left": "KEY_D",
    "Right": "KEY_G",
    "Hit": "KEY_Z",
    "Buttons": {
      "A": "KEY_Z",
      "B": "KEY_X",
      "X": "KEY_C",
