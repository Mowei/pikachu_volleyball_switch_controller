{
  // 按鍵名稱需對應 KeyboardSender.cs 裡 VirtualKeyShort 列舉的成員名稱（例如 KEY_A、SPACE、F1、OEM_1 等）
  // 修改後需重新啟動程式才會套用新的按鍵綁定
  "SinglePlayer": {
    // 單人模式：命令列參數帶入 single 時使用（例如 dotnet run -- single）
    // 手把向上加速度超過 JumpThreshold 時觸發
    "Jump": "UP_ARROW",
    // 手把向下加速度低於 DownThreshold 時按住
    "Down": "DOWN_ARROW",
    // 手把向左傾斜超過 MoveThreshold 時按住
    "Left": "LEFT_ARROW",
    // 手把向右傾斜超過 MoveThreshold 時按住
    "Right": "RIGHT_ARROW",
    // 任一軸向陀螺儀角速度超過 HitThreshold 時觸發（揮擊動作）
    "Hit": "RETURN"
  },
  "DualPlayer": {
    // 雙人模式的預設設定：1P 左控制器 + 2P 右控制器同時啟用
    "Jump": "KEY_R",
    "Down": "KEY_F",
    "Left": "KEY_D",
    "Right": "KEY_G",
    "Hit": "KEY_Z"
  },
  "LeftPlayer": {
    // 1P（左控制器）
    "Jump": "KEY_R",
    "Down": "KEY_F",
    "Left": "KEY_D",
    "Right": "KEY_G",
    "Hit": "KEY_Z"
  },
  "RightPlayer": {
    // 2P（右控制器） / 單人模式
    "Jump": "UP_ARROW",
    "Down": "DOWN_ARROW",
    "Left": "LEFT_ARROW",
    "Right": "RIGHT_ARROW",
    "Hit": "RETURN"
  }
}